# Production database artifacts
# Les .sqlite sont des artefacts de build, reconstructibles par
# scripts/build_sqlite.py — ils ne sont jamais versionnés.
# Seul le .sha256 est suivi, comme preuve de reproductibilité.
*.sqlite
*.sqlite-journal
*.sqlite-wal
*.sqlite-shm
!*.sqlite.sha256

# Données sources (volumineuses, hors périmètre git)
data/raw/
data/processed/
!data/synthetic/

